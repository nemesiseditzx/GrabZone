# GrabZone order email configuration
RESEND_API_KEY=
ORDER_EMAIL_FROM=GrabZone <orders@grabzone.store>
# Prefer the new Supabase secret key. Keep it server-side only.
# Legacy alternative if your project still uses it:
# Business Koro storefront API key (keep server-side only)
BUSINESS_KORO_API_KEY=

# Google Sheets order record (native Google Sheet ID, not an .xlsx file)
GOOGLE_SHEETS_SPREADSHEET_ID=
# Cloudflare R2 product/site image storage
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=https://cdn.example.com

# Cloudflare D1 (Vercel -> D1 REST bridge)
D1_DATABASE_ID=ffaa2c49-c89e-439f-9a71-89144b07dfce
CF_API_TOKEN=

# D1-native Admin Panel authentication
GRABZONE_ADMIN_EMAIL=
GRABZONE_ADMIN_PASSWORD=
D1_AUTH_SECRET=
