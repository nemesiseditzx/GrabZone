# GrabZone — Cloudflare Worker secrets/vars
# D1 and R2 are connected through wrangler.jsonc bindings.
D1_AUTH_SECRET=
GRABZONE_ADMIN_EMAIL=
GRABZONE_ADMIN_PASSWORD=

# R2 public URL (optional). If blank, Worker serves uploaded objects at /api/r2/<key>.
R2_PUBLIC_BASE_URL=

# Optional integrations
BUSINESS_KORO_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SHEETS_SPREADSHEET_ID=
GMAIL_FROM_EMAIL=
RESEND_API_KEY=
ORDER_EMAIL_FROM=
