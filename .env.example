# GrabZone — Cloudflare Worker secrets/vars
# D1 and R2 are connected through wrangler.jsonc bindings.
D1_AUTH_SECRET=
MARKETPLACE_AUTH_SECRET=
GRABZONE_ADMIN_EMAIL=
GRABZONE_ADMIN_PASSWORD=

# R2 public URL (optional). Marketplace vendor uploads are served through the Worker when blank.
R2_PUBLIC_BASE_URL=

# Optional integrations
BUSINESS_KORO_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SHEETS_SPREADSHEET_ID=
GMAIL_FROM_EMAIL=
RESEND_API_KEY=
ORDER_EMAIL_FROM=

# Transactional email fallback providers (configure only verified sender addresses)
BREVO_API_KEY=
BREVO_FROM_EMAIL=
MAILTRAP_API_TOKEN=
MAILTRAP_FROM_EMAIL=
# Optional comma-separated provider order; defaults to resend,brevo,mailtrap,gmail
EMAIL_PROVIDER_ORDER=
# Optional transactional-only override, e.g. resend,brevo,mailtrap,gmail
EMAIL_PROVIDER_ORDER_TRANSACTIONAL=
